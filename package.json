{
  "name": "pocket-flashcards",
  "version": "0.1.0",
  "description": "Private, offline flashcards in plain Markdown. Your cards never leave your device.",
  "license": "MIT",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "node --test \"test/**/*.test.js\"",
    "lint": "eslint . && prettier --check .",
    "format": "prettier --write .",
    "typecheck": "tsc -p jsconfig.json",
    "serve": "node scripts/serve.mjs",
    "vendor": "node scripts/vendor.mjs",
    "changelog": "node scripts/changelog.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/node": "22.20.7",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "mermaid": "12.3.0",
    "prettier": "3.10.1",
    "typescript": "7.0.2"
  }
}
